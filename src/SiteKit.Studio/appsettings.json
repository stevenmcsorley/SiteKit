{
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/SiteKit.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "b9cc84d4-3cc0-4dc8-9a63-2e86d54bd21e",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowConcurrentVariants": false
      },
      "Security": {
        "AllowConcurrentLogins": false
      }
    }
  },
  "SiteKit": {
    "DataPath": "data/sitekit",
    "GeneratedProjectsPath": "generated-projects"
  }
}
